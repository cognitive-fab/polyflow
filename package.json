{
  "name": "polyflow",
  "version": "0.1.0",
  "description": "A workflow engine for AI agents: the agent reasons a workflow, polyflow admits it only if it model-checks, then runs it durably and hands the agent one work order at a time.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "polyflow-mcp": "bin/polyflow-mcp.mjs",
    "polyflow-install": "bin/polyflow-install.mjs"
  },
  "scripts": {
    "test": "node --no-warnings --test \"test/*.test.mjs\"",
    "mcp": "node bin/polyflow-mcp.mjs",
    "test:seam": "spike\\.venv\\Scripts\\python.exe test/integration/openworker_seam.py",
    "test:session": "spike\\.venv\\Scripts\\python.exe test/integration/openworker_session.py",
    "test:batch": "spike\\.venv\\Scripts\\python.exe test/integration/batch.py",
    "install:openworker": "node bin/polyflow-install.mjs"
  },
  "dependencies": {
    "@cognitive-fab/sam-pattern": "^2.2.0",
    "polygraph": "github:cognitive-fab/polygraph"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitive-fab/polyflow.git"
  },
  "homepage": "https://github.com/cognitive-fab/polyflow#readme",
  "bugs": {
    "url": "https://github.com/cognitive-fab/polyflow/issues"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "workflow-engine",
    "durable-execution",
    "model-checking",
    "state-machine",
    "procedural-memory",
    "openworker",
    "polyrun"
  ]
}
