# platform test scratch
platform/examples/.tmp-*
platform/packages/*/workflow-bundle-*.js

platform/python/.venv/
**/__pycache__/

# fetched at install time (pinned, sha256-checked), not committed
platform/python/polyflow_temporal/vendor/quickjs-wasi/quickjs.wasm

# certificates are produced by `polyflow admit --key` in CI, never committed
platform/examples/temporal_samples/**/polyflow.certificate.json
