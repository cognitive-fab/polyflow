diff --git a/coworker/mcp/config.py b/coworker/mcp/config.py
index 8bdbead..f177ea8 100644
--- a/coworker/mcp/config.py
+++ b/coworker/mcp/config.py
@@ -36,6 +36,10 @@ class MCPServerDef:
     include_tools: Optional[list[str]] = None
     exclude_tools: Optional[list[str]] = None
     requires_approval: bool = True
+    # Per-tool risk override: {"tool_name": "low"|"medium"|"high"}. MCP tools are
+    # otherwise uniformly "medium", which makes a server's read-only tools
+    # ineligible for `_parallel_safe` and indistinguishable from its writes.
+    tool_risk: dict[str, str] = field(default_factory=dict)
     # "oauth" → browser OAuth 2.1 + PKCE with Dynamic Client Registration (mcp/oauth.py).
     # HTTP transport only; tokens live in the SecretStore, never in this file.
     auth: Optional[str] = None
@@ -82,6 +86,7 @@ def _parse(name: str, raw: dict[str, Any], secrets: SecretStore) -> MCPServerDef
         include_tools=raw.get("include_tools"),
         exclude_tools=raw.get("exclude_tools"),
         requires_approval=bool(raw.get("requires_approval", True)),
+        tool_risk={str(k): str(v).lower() for k, v in (raw.get("tool_risk") or {}).items()},
         auth=(str(raw["auth"]).lower() if raw.get("auth") else None),
     )
 
diff --git a/coworker/mcp/tools.py b/coworker/mcp/tools.py
index ecd8a14..fbf7418 100644
--- a/coworker/mcp/tools.py
+++ b/coworker/mcp/tools.py
@@ -17,6 +17,8 @@ import aisuite as ai
 
 from .config import MCPServerDef
 
+_RISK = {"low", "medium", "high"}
+
 CallAsync = Callable[[str, dict[str, Any]], Awaitable[Any]]
 
 _NAME_OK = re.compile(r"[^a-zA-Z0-9_-]")
@@ -43,6 +45,13 @@ def _openai_schema(name: str, mcp_tool: Any) -> dict[str, Any]:
     }
 
 
+def _risk_for(server: MCPServerDef, tool: str) -> str:
+    """Declared risk for one tool, defaulting to the uniform "medium". An
+    unrecognised value is ignored rather than trusted — fail closed."""
+    declared = (getattr(server, "tool_risk", None) or {}).get(tool)
+    return declared if declared in _RISK else "medium"
+
+
 def _filtered(mcp_tools: list[Any], server: MCPServerDef) -> list[Any]:
     out = mcp_tools
     if server.include_tools is not None:
@@ -82,7 +91,7 @@ def build_callables(
         _invoke.__aisuite_tool_metadata__ = ai.ToolMetadata(
             name=name,
             category="mcp",
-            risk_level="medium",
+            risk_level=_risk_for(server, remote),
             capabilities=[server.name],
             requires_approval=server.requires_approval,
         )
