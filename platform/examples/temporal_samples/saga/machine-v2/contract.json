  "terminalKey": "phase",
  "terminalStates": [
    "opened",
    "compensated",
    "compensation_failed",
    "failed",
    "stopped"
  ],
  "specialRules": [
    {
      "name": "stale-completions-reject",
      "note": "A completion arriving in any state other than the one that awaits it is an observable rejection (post == pre), never a fault.",
      "whenState": "any non-awaiting state",
      "whenAction": "every completion action"
    },
    {
      "name": "compensate-lifo",
      "note": "A forward step's failure compensates the steps that succeeded before it, last first: a KYC failure disconnects the bank account, removes the client, then clears the address.",
      "whenState": "adding_client | adding_bank | adding_kyc",
      "whenAction": "CLIENT_FAILED | BANK_FAILED | KYC_FAILED"
    }
  ],
  "noOpRule": "An action that does not apply in the current state is reject(reason) - an observable no-op with post == pre."
}
