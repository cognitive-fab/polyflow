{
  "lang": "javascript",
  "stateKeys": [
    {
      "name": "phase",
      "type": "enum: 'idle' | 'creating_account' | 'adding_address' | 'adding_client' | 'adding_bank' | 'adding_kyc' | 'opened' | 'undo_bank' | 'undo_client' | 'undo_address' | 'compensated' | 'compensation_failed' | 'failed' | 'stopped'"
    },
    {
      "name": "params",
      "type": "object, the OpenAccount command ({ accountId, bankId, clientEmail, address, bankDetails, failAt }); {} before START"
    },
    {
      "name": "failedStep",
      "type": "enum: '' | 'createAccount' | 'addAddress' | 'addClient' | 'addBankAccount' | 'addKycCheck', the forward step that failed ('' if none)"
    },
    {
      "name": "reason",
      "type": "string, why the run ended without opening ('' otherwise)"
    }
  ],
  "initState": {
    "phase": "idle",
    "params": {},
    "failedStep": "",
    "reason": ""
  },
  "actions": {
    "START": {
      "dataFields": {
        "accountId": "string",
        "bankId": "string",
        "clientEmail": "string",
        "address": "object, PostalAddress",
        "bankDetails": "object, BankDetails",
        "failAt": "enum: '' | 'createAccount' | 'addAddress' | 'addClient' | 'addBankAccount' | 'addKycCheck', the sample's failure injection (shouldThrow on that step's command)"
      }
    },
    "ACCOUNT_CREATED": {
      "dataFields": {}
    },
    "ACCOUNT_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "ADDRESS_ADDED": {
      "dataFields": {}
    },
    "ADDRESS_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "CLIENT_ADDED": {
      "dataFields": {}
    },
    "CLIENT_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "BANK_ADDED": {
      "dataFields": {}
    },
    "BANK_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "KYC_PASSED": {
      "dataFields": {}
    },
    "KYC_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "BANK_DISCONNECTED": {
      "dataFields": {}
    },
    "BANK_DISCONNECT_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "CLIENT_REMOVED": {
      "dataFields": {}
    },
    "CLIENT_REMOVE_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "ADDRESSES_CLEARED": {
      "dataFields": {}
    },
    "ADDRESSES_CLEAR_FAILED": {
      "dataFields": {
        "reason": "string"
      }
    },
    "STOP": {
      "dataFields": {}
    }
  },
  "dataDomain": {
    "START": {
      "accountId": [
        "acc-1"
      ],
      "bankId": [
        "Foo Bar Savings and Loan"
      ],
      "clientEmail": [
        "bart@simpson.io"
      ],
      "address": [
        {
          "address1": "123 Temporal Street",
          "postalCode": "98006"
        }
      ],
      "bankDetails": [
        {
          "accountNumber": "111",
          "routingNumber": "1234555",
          "accountType": "Checking",
          "personalOwner": {
            "firstName": "Bart",
            "lastName": "Simpson"
          }
        }
      ],
      "failAt": [
        "",
        "addBankAccount",
        "addKycCheck"
      ]
    },
    "ACCOUNT_CREATED": {},
    "ACCOUNT_FAILED": {
      "reason": [
        "step-failed"
      ]
    },
    "ADDRESS_ADDED": {},
    "ADDRESS_FAILED": {
      "reason": [
        "step-failed"
      ]
    },
    "CLIENT_ADDED": {},
    "CLIENT_FAILED": {
      "reason": [
