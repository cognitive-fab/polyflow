{
  "name": "@cognitive-fab/polyflow-sample-saga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Temporal's saga sample on Polyflow at G2/G3, with a v2 through the version gate (see README.md)",
  "scripts": {
    "admit": "polyflow admit ./machine && polyflow admit ./machine-v2",
    "start": "node --import ./src/register.mjs src/worker.mjs",
    "start.v2": "node --import ./src/register.mjs src/worker.mjs ../machine-v2/",
    "workflow": "node src/client.mjs",
    "workflow-compensate": "node src/client.mjs --fail-at addBankAccount"
  },
  "dependencies": {
    "@cognitive-fab/polyflow-temporal": "0.1.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/envconfig": "^1.24.0",
    "@temporalio/worker": "^1.24.0"
  },
  "license": "MIT"
}
